# Domain used by Caddy (deploy/Caddyfile)
A2A_DOMAIN=a2a.example.com
# ---- copy to .env and fill in. NEVER commit .env ----
# Public HTTPS URL of this bridge (used in Agent Cards and callback URLs)
A2A_PUBLIC_BASE_URL=https://a2a.example.com
# Inbound API keys for external agents. Comma separated: label=sha256:<hex>[@agent1|agent2]
# Generate: python scripts/gen_secret.py apikey partner1
A2A_API_KEYS=partner1=sha256:REPLACE_WITH_64_HEX
A2A_AGENTS_CONFIG=/app/config/agents.json
A2A_DEFAULT_AGENT=gateway
A2A_DB_PATH=/app/data/bridge.db

# ---- per bot (names referenced from agents.json) ----
BOT_GATEWAY_WEBHOOK_URL=https://bot.example.com/webhook/REPLACE
BOT_GATEWAY_WEBHOOK_TOKEN=REPLACE_routine_sender_key
BOT_GATEWAY_SHARED_SECRET=REPLACE_at_least_32_chars_random_secret
BOT_CODER_WEBHOOK_URL=https://bot.example.com/hooks/a2a
BOT_CODER_WEBHOOK_TOKEN=REPLACE_long_random_token
BOT_CODER_SHARED_SECRET=REPLACE_at_least_32_chars_random_secret
BOT_ASSISTANT_WEBHOOK_URL=https://bot2.example.com/hooks/a2a
BOT_ASSISTANT_WEBHOOK_TOKEN=REPLACE_long_random_token
BOT_ASSISTANT_SHARED_SECRET=REPLACE_at_least_32_chars_random_secret

# ---- tuning (defaults shown) ----
A2A_HOST=0.0.0.0
A2A_PORT=8080
A2A_LOG_LEVEL=INFO
A2A_MAX_REQUEST_BYTES=10485760
A2A_RATE_LIMIT_PER_MIN=120
A2A_RATE_LIMIT_BURST=60
A2A_TASK_TIMEOUT_S=3600
A2A_INPUT_REQUIRED_TIMEOUT_S=86400
A2A_RETENTION_DAYS=30
A2A_WEBHOOK_TIMEOUT_S=15
A2A_WEBHOOK_MAX_ATTEMPTS=8
A2A_WEBHOOK_BACKOFF_BASE_S=2
A2A_WEBHOOK_BACKOFF_MAX_S=300
# extra retries for 4xx other than 401/403/404 (which fail immediately), and delay before each
A2A_WEBHOOK_4XX_RETRIES=1
A2A_WEBHOOK_4XX_RETRY_DELAY_S=10
A2A_SSE_HEARTBEAT_S=15
A2A_BLOCKING_WAIT_S=30
A2A_CALLBACK_MAX_SKEW_S=300
A2A_PUSH_ALLOW_HTTP=false
A2A_PUSH_ALLOW_PRIVATE=false
# true only when behind Caddy/nginx (X-Forwarded-For used for rate limiting)
A2A_TRUST_PROXY_HEADERS=true

# ---- roster (GET /roster, /roster/{agent}, /roster/stream) ----
# Per-key privacy tier. Labels not listed default to basic. Does not change A2A_API_KEYS.
# Example: A2A_KEY_TIERS=ops:owner,partner-1:trusted
A2A_KEY_TIERS=
A2A_ROSTER_STUCK_AFTER_S=900
A2A_ROSTER_OFFLINE_AFTER_S=120
A2A_ROSTER_MAX_STREAMS_PER_KEY=3
A2A_ROSTER_MAX_STREAMS=32
A2A_ROSTER_MAX_ANON_STREAMS=3
A2A_ROSTER_STREAM_TIMEOUT_S=30
A2A_ROSTER_STREAM_MAX_S=300
A2A_ROSTER_PUBLIC=false
# Comma-separated words or regexes replaced with [redacted] in trusted activity text
A2A_ROSTER_REDACT=
A2A_ROSTER_DEBOUNCE_S=1
A2A_ROSTER_DEBOUNCE_MAX_S=2
A2A_ROSTER_OFFLINE_TTL_S=3600
